rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAllowedUser() {
      return signedIn()
        && request.auth.token.timegridOwner == true;
    }
    function isOwner(uid) {
      return isAllowedUser() && request.auth.uid == uid;
    }

    match /users/{uid}/settings/{docId} {
      allow read, write: if isOwner(uid) && docId == 'main';
    }
    match /users/{uid}/days/{dayId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid);
    }
  }
}
